{
  "name": "qa-automation-framework",
  "private": true,
  "version": "1.0.0",
  "description": "QA automation framework: web (Playwright), API (Playwright), mobile (Appium/WebdriverIO), and SQL suites targeting automationexercise.com",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:web": "npm run test --workspace=@framework/web",
    "test:api": "npm run test --workspace=@framework/api",
    "test:mobile": "npm run test --workspace=@framework/mobile",
    "test:sql": "npm run test --workspace=@framework/sql",
    "test": "npm run test:web && npm run test:api && npm run test:sql",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "engines": {
    "node": ">=24"
  }
}
