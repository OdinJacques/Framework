# Shared target application (front-end + API suites share this domain)
WEB_BASE_URL=https://automationexercise.com
# Trailing slash matters here: APIRequestContext resolves a leading-slash
# request path as an absolute path on the origin, which would otherwise drop
# the /api segment (see apps/api/src/clients/api-client.ts for details).
API_BASE_URL=https://automationexercise.com/api/

# Demo user credentials used by both the web UI login flow and the API auth endpoints.
# automationexercise.com requires an account to exist before these will work end-to-end;
# create one manually via the site's signup flow and put the credentials here.
DEMO_USER_NAME=Framework QA
DEMO_USER_EMAIL=framework.qa.demo@example.com
DEMO_USER_PASSWORD=ChangeMe123!

# Appium server connection (used by apps/mobile)
APPIUM_HOST=localhost
APPIUM_PORT=4723
